<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Spek.Net.WinUI</RootNamespace>
    <PackageId>Spek.NET.WinUI</PackageId>
    <Description>A WinUI 3 control that draws Spek's spectrogram with Win2D as the audio decodes.</Description>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The app that uses this library picks the platform, and Win2D's native DLL comes with it from there. -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spek.Net\Spek.Net.csproj" />
  </ItemGroup>
</Project>
