<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentSpek.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:spek="using:Spek.Net.WinUI"
    Title="FluentSpek">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="FluentSpek" />

        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            OverflowButtonVisibility="Collapsed">
            <AppBarButton
                Click="Open_Click"
                Icon="OpenFile"
                Label="Open"
                ToolTipService.ToolTip="Open an audio file (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="SaveButton"
                Click="Save_Click"
                Icon="Save"
                IsEnabled="False"
                Label="Save image"
                ToolTipService.ToolTip="Save the spectrogram as a PNG (Ctrl+S)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="PaletteButton" ToolTipService.ToolTip="Palette (P, Shift+P)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="PaletteMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="WindowButton" ToolTipService.ToolTip="Window function (F, Shift+F)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="WindowMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="FftButton" ToolTipService.ToolTip="FFT window size (W, Shift+W)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B9;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="FftMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="ChannelButton" ToolTipService.ToolTip="Channel (C, Shift+C)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8D6;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="ChannelMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                x:Name="StreamButton"
                ToolTipService.ToolTip="Audio stream (S, Shift+S)"
                Visibility="Collapsed">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="StreamMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Click="Settings_Click"
                Icon="Setting"
                Label="Settings"
                ToolTipService.ToolTip="Settings (Ctrl+E)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="E" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <spek:SpekView
            x:Name="Spek"
            Grid.Row="2"
            AllowDrop="True" />

        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Done"
            DefaultButton="Close">
            <StackPanel MinWidth="380" Spacing="12">
                <ToggleSwitch x:Name="FullPathToggle" Header="Show the full path above the spectrogram" />
                <ToggleSwitch x:Name="DetailedToggle" Header="Show the FFT size and window function in the description" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox
                        x:Name="UpperBox"
                        Header="Upper limit (dBFS)"
                        Maximum="0"
                        Minimum="-139"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="LowerBox"
                        Header="Lower limit (dBFS)"
                        Maximum="-1"
                        Minimum="-140"
                        SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <TextBox
                    x:Name="FfmpegBox"
                    Header="ffmpeg.exe"
                    PlaceholderText="Next to FluentSpek.exe, or on PATH" />
                <TextBlock
                    x:Name="FfmpegStatus"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
